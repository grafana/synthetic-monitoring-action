--- /dev/null
+++ b/src/api/subscriptions.ts
@@ -0,0 +1,10 @@
+// New feature: customers can start a recurring Premium subscription, charged via
+// the existing payment provider integration.
+export async function createSubscription(req: Request, res: Response) {
+  const { userId, plan, paymentMethodId } = req.body;
+  const charge = await paymentProvider.charge(paymentMethodId, plan.priceCents);
+  const subscription = await db.subscriptions.insert({ userId, plan: plan.id, chargeId: charge.id });
+  res.status(201).json({ subscriptionId: subscription.id, status: 'active' });
+}
